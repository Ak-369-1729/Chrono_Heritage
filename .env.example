# ChronoHeritage V3.0 environment. Copy to .env and replace every "change-me" value. Never commit .env.
# Windows PowerShell: see docs/WINDOWS_SETUP.md, which generates the secrets without printing them.
CHRONO_ENV=development

# PostgreSQL (reachable only inside the Compose network; the port is not published).
POSTGRES_DB=chronoheritage
POSTGRES_USER=chrono
POSTGRES_PASSWORD=change-me-db-password

# Signs session tokens. A value starting with "change-me" is ignored (development falls back to a temporary key
# that resets sessions on restart; production refuses to start). Generate 48+ random characters.
CHRONO_SECRET_KEY=change-me-long-random-secret
# true when served over HTTPS
CHRONO_COOKIE_SECURE=false

# Public sign-up: open (researcher accounts active at once) | approval (an administrator activates every new
# account) | closed. Data Steward and Reviewer roles always need an administrator's approval; admin is never
# available through sign-up.
CHRONO_REGISTRATION_MODE=open
# Queued or running calculations allowed per non-admin user.
CHRONO_MAX_ACTIVE_JOBS_PER_USER=3
# Abuse limits (per client address, counted in each API worker).
CHRONO_REGISTER_LIMIT_PER_HOUR=10
CHRONO_LOGIN_LIMIT_PER_5MIN=10

# Optional bootstrap accounts, created once by `python -m app.seed` at API start-up. An account whose password is
# blank is skipped (nothing is generated or printed). The recommended way to create the first administrator is the
# interactive command in docs/WINDOWS_SETUP.md / README:
#   docker compose exec api python -m app.manage create-user --email you@example.org --role admin
CHRONO_ADMIN_EMAIL=
CHRONO_ADMIN_PASSWORD=
CHRONO_REVIEWER_EMAIL=
CHRONO_REVIEWER_PASSWORD=
CHRONO_STEWARD_EMAIL=
CHRONO_STEWARD_PASSWORD=
CHRONO_RESEARCHER_EMAIL=
CHRONO_RESEARCHER_PASSWORD=

# Load the five FICTIONAL demonstration sites (clearly labelled illustrative; never counted as evidence).
CHRONO_SEED_DEMO=true

# JPL Horizons is contacted only by the benchmark suite. Set false for air-gapped deployments (modern cases are
# then reported as "blocked", never as passed).
CHRONO_HORIZONS_ENABLED=true
CHRONO_HORIZONS_TIMEOUT_S=20

CHRONO_API_WORKERS=2
CHRONO_MAX_UPLOAD_BYTES=5242880
CHRONO_LOG_LEVEL=INFO
